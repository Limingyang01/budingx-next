{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": [
      "node"
    ],
    "noEmitOnError": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "../core/**/*.ts",
    "../provider/**/*.ts",
    "../storage/**/*.ts",
    "../workspace/**/*.ts",
    "../exec/**/*.ts",
    "../git/**/*.ts",
    "../plan/**/*.ts",
    "../observability/**/*.ts",
    "../host/**/*.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "dist"
  ]
}
