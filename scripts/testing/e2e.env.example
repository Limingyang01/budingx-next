# 真实 Provider e2e 测试模板（仅此模板可提交）。
# 将本文件复制为仓库根目录的 .env.e2e.local，填写后告知 Agent。
# .env.e2e.local 已被 Git 忽略；不要把密钥发到聊天里。
# 不读取其他客户端的配置、凭据或聊天记录。

# OpenAI 兼容 API 前缀；客户端会追加 /chat/completions。
# 示例：https://api.example.com/v1
BUDINGX_BASE_URL=

# 服务端接受的完整模型名称。
BUDINGX_MODEL=

# 只在 .env.e2e.local 中填写真实密钥。
BUDINGX_API_KEY=

# 用户允许的本轮总测试费用上限（美元），例如 0.50；留空则不执行真实请求。
# 此字段记录授权额度；实际执行还将限制请求数和 max_tokens，不能替代供应商账单限额。
BUDINGX_E2E_BUDGET_USD=

# 是否支持 OpenAI function/tool calls：填写 yes 或 no。
BUDINGX_E2E_SUPPORTS_TOOLS=

# 本轮允许的最大 HTTP 请求数（包含错误场景），建议 6。
BUDINGX_E2E_MAX_REQUESTS=6

# 单次输出 token 上限；某些推理模型需要更大值，可填写适用上限。
BUDINGX_E2E_MAX_TOKENS=128

# ===== 本机 Langfuse 观测（可选，默认关闭）=====
# 真实值由 scripts/langfuse/init-local.mjs 生成到 .runtime/langfuse/（login.json / agent.env），
# 再填入 .env.e2e.local；本模板只留占位符，勿提交真实密钥。操作见 skills/buding-langfuse。
# Web UI 登录邮箱/密码（http://localhost:3000，需 WSL 保活 + compose override）：
BUDINGX_LANGFUSE_EMAIL=
BUDINGX_LANGFUSE_PASSWORD=
# 追踪开关（1 启用）；正文采集（1 采集 user/assistant 与工具 IO，默认 0 只采元数据）：
BUDINGX_LANGFUSE_ENABLED=
BUDINGX_LANGFUSE_CAPTURE_CONTENT=0
# Langfuse 地址与项目密钥（取自 agent.env）；http 仅限本机地址：
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# verify-agent.mjs 三场景用的模型别名（可复用上方 BUDINGX_BASE_URL/MODEL/API_KEY）：
BUDINGX_SMOKE_MODEL_BASE_URL=
BUDINGX_SMOKE_MODEL=
BUDINGX_SMOKE_MODEL_KEY=
