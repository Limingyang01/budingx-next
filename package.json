{
  "name": "budingx-next-maintenance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private development and release tooling for the independent budingx TUI",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "skills:sync": "node scripts/skills/sync-entries.mjs",
    "skills:check": "node scripts/skills/sync-entries.mjs --check",
    "skills:test": "node --test scripts/skills/*.test.mjs",
    "spec:check": "node scripts/spec/check-spec.mjs",
    "spec:test": "node --test scripts/spec/*.test.mjs",
    "build": "tsc -p src/tui/tsconfig.json",
    "start": "node --env-file-if-exists=.env.e2e.local src/tui/dist/tui/cli.js",
    "test:unit": "npm run build && node --test src/*/test/*.test.mjs",
    "test:checks": "node scripts/checks/module-boundaries.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "merge:test": "node --test scripts/merge/*.test.mjs",
    "merge:gate": "node scripts/merge/cross-validate.mjs",
    "test": "npm run skills:test && npm run spec:test && npm run test:unit && npm run test:checks && npm run test:release && npm run merge:test",
    "publish": "node scripts/release/publish.mjs",
    "version:prepare": "node scripts/release/version.mjs",
    "release:sync": "node scripts/release/receipt.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "9.0.0",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  },
  "license": "MIT"
}
